  "image": "// \"Dying Universe\" by Martijn Steinrucken aka BigWings - 2015\n// License Creative Commons Attribution-NonCommercial-ShareAlike 3.0 Unported License.\n// Email:countfrolic@gmail.com Twitter:@The_ArtOfCode\n\n// Song:\n// Cubicolor - Fictionalise (Lindstr\u00f8m & Prins Thomas Remix)\n// https://soundcloud.com/cubicolor/fictionalise-lindstrom-prins-thomas-remix\n\nstatic float4 COOLCOLOR = float4(1.,.5,0.,0.);\nstatic float4 HOTCOLOR = float4(0.,0.1,1.,1.);\n\nstatic float4 MIDCOLOR = float4(0.5,0.3,0.,1.);\nstatic float STARSIZE = 0.03;\n#define NUM_STARS 100\n#define NUM_BOUNCES 6\n#define FLOOR_REFLECT\n\nfloat DistSqr(float3 a, float3 b) { float3 D=a-b; return dot(D, D); } \nfloat dist2(float2 P0, float2 P1) { float2 D=P1-P0; return dot(D,D); }\n\nstatic const float3 up = float3(0.,1.,0.);\nstatic const float pi = 3.141592653589793238;\nstatic const float twopi = 6.283185307179586;\nstatic float gTime;\n\nstruct ray {\n    float3 o;\n    float3 d;\n};\nstatic ray e;\t\t\t\t// the eye ray\n\nstruct camera {\n    float3 p;\t\t\t// the position of the camera\n    float3 forward;\t// the camera forward vector\n    float3 left;\t\t// the camera left vector\n    float3 up;\t\t// the camera up vector\n\t\n    float3 center;\t// the center of the screen, in world coords\n    float3 hit; // screen hit in world coords\n    ray ray;\t\t// the current ray: from cam pos, through current uv projected on screen\n    float3 lookAt;\t// the lookat point\n    float zoom;\t\t// the zoom factor\n};\nstatic camera cam;\n\nvoid CameraSetup(float2 puv, float3 position, float3 lookAt, float zoom) {\n\t\n    cam.p = position;\n    cam.lookAt = lookAt;\n    cam.forward = normalize(cam.lookAt-cam.p);\n    cam.left = cross(up, cam.forward);\n    cam.up = cross(cam.forward, cam.left);\n    cam.zoom = zoom;\n    \n    cam.center = cam.p+cam.forward*cam.zoom;\n    cam.hit = cam.center+cam.left*puv.x+cam.up*puv.y;\n    \n    cam.ray.o = cam.p;\t\t\t\t\t\t// ray origin = camera position\n    cam.ray.d = normalize(cam.hit-cam.p);\t// ray direction is the vector from the cam pos through the point on the imaginary screen\n}\n\nfloat4 Noise401( float4 x ) { return frac(sin(x)*5346.1764); }\nfloat4 Noise4( float4 x ) { return frac(sin(x)*5346.1764)*2. - 1.; }\nfloat Noise101( float x ) { return frac(sin(x)*5346.1764); }\n\nfloat hash( float n ) { return frac(sin(n)*753.5453123); }\nfloat noise( float3 x )\n{\n    float3 p = floor(x);\n    float3 f = frac(x);\n    f = f*f*(3.0-2.0*f);\n\t\n    float n = p.x + p.y*157.0 + 113.0*p.z;\n    return lerp(lerp(lerp( hash(n+  0.0), hash(n+  1.0),f.x),\n                   lerp( hash(n+157.0), hash(n+158.0),f.x),f.y),\n               lerp(lerp( hash(n+113.0), hash(n+114.0),f.x),\n                   lerp( hash(n+270.0), hash(n+271.0),f.x),f.y),f.z);\n}\nstatic const float3x3 m = float3x3( 0.00,  0.80,  0.60,\n                    -0.80,  0.36, -0.48,\n                    -0.60, -0.48,  0.64 );\n\n\nfloat PeriodicPulse(float x, float p) {\n    // pulses from 0 to 1 with a period of 2 pi\n    // increasing p makes the pulse sharper\n\treturn pow((cos(x+sin(x))+1.)/2., p);\n}\n\nfloat SlantedCosine(float x) {\n    // its a cosine.. but skewed so that it rises slowly and drops quickly\n    // if anyone has a better function for this i'd love to hear about it\n\tx -= 3.55;\t// shift the phase so its in line with a cosine\n    return cos(x-cos(x)*0.5);\n}\n\nfloat3 ClosestPoint(ray r, float3 p) {\n    // returns the closest point on ray r to point p\n    return r.o + max(0., dot(p-r.o, r.d))*r.d;\n}\n\n\n\nfloat BounceFast(float t) {\n\t// Precomputed bounced interpolation\n    // 2 bounces, decay of 0.3\n    \n    t *= 2.695445115; // comment out if you don't need t normalized\n    \n    float a1 = 1.-t*t;\n    t -= 1.5477225575; // 1 + sqrt(0.3)\n    float a2 = 0.3-t*t;\n    t -= 0.8477225575; // sqrt(0.3) + sqrt(0.09)\n    float a3 = 0.09-t*t;\n    \n    return max(max(a1, a2), max(a3, 0.));\n}\n\n#define NUM_ARCS (NUM_BOUNCES+1)\nfloat Bounce(float t, float decay) {\n    // Returns a bounced interpolation\n    // t = gTime\n    //     start of bounce is 0   \n    //     end of bounce depends on number of bounces and decay param\n    // decay = how much lower each successive bounce is\n    //\t\t0 = there is no bounce at all\n    //\t\t0.5 = each successive bounce is half as high as the previous one\n    //\t\t1 = there is no energy loss, it would bounce forever\n \n    \n    float height = 1.;\n    float halfWidth=1.;\n    float previousHalf = 1.;\n    \t\t\n    float y = 1.-t*t;\n   \n    height = 1.;\n    for(int bi=1; bi<NUM_BOUNCES; bi++) {\n        height *= decay;\n        previousHalf = halfWidth;\n    \thalfWidth = sqrt(height);\n        t -= previousHalf + halfWidth;\n        y = max(y, height - t*t);\n    }\n    \n    return saturate( y );\n}\n\nfloat BounceNorm(float t, float decay) {\n    float height = 1.0;\n    float heights[7];\n    float halfDurations[7];\n    heights[0] = 1.0;\n    halfDurations[0] = 1.0;\n    float halfDuration = 0.5;\n    [unroll] for (int bi = 1; bi < 7; bi++) {\n        height *= decay;\n        heights[bi] = height;\n        halfDurations[bi] = sqrt(height);\n        halfDuration += halfDurations[bi];\n    }\n    t *= halfDuration * 2.0;\n    float y = 1.0 - t * t;\n    [unroll] for (int bj = 1; bj < 7; bj++) {\n        t -= halfDurations[bj - 1] + halfDurations[bj];\n        y = max(y, heights[bj] - t * t);\n    }\n    return saturate(y);\n}\n\nfloat3 IntersectPlane(ray r, float4 plane) {\n    // returns the intersection point between a ray and a plane\n\tfloat3 n = plane.xyz;\n    float3 p0 = plane.xyz*plane.w;\n    float t = dot(p0-r.o, n)/dot(r.d, n);\n    return r.o+max(0.,t)*r.d;\t\t\t\t// not quite sure what to return if there is no intersection\n    \t\t\t\t\t\t\t\t\t\t// right now it just returns the ray origin\n}\nfloat3 IntersectPlane(ray r) {\n    \t// no plane param gives ground-plane intersection\n    return IntersectPlane(r, float4(0.,1.,0.,0.));\n}\n\nfloat Circle(float2 pos, float2 puv, float radius) {\n\treturn smoothstep(radius, radius*0.9, length(puv-pos));\n}\n\n// -------------------------------------------------------------\n\n\nfloat4 Star(ray r, float seed) {\n    float4 noise = Noise4(float4(seed, seed+1., seed+2., seed+3.));\n    \n\tfloat t = frac(gTime*0.1+seed)*2.;\n    \n    float fade = smoothstep(2., 0.5, t);\t\t// fade out;\n    float4 col = lerp(COOLCOLOR, HOTCOLOR, fade); // vary color with size\n    float size = STARSIZE+seed*0.03;\t\t\t\t\t// random variation in size\n    size *= fade;\n    \n    float b = BounceNorm(t, 0.4+seed*0.1)*7.;\n    b+=size;\n    \n    float3 sparkPos = float3(noise.x*10., b, noise.y*10.);\n    float3 closestPoint = ClosestPoint(r, sparkPos);\n    \n    float dist = DistSqr(closestPoint, sparkPos)/(size*size);\n    float brightness = 1./dist;\n    col *= brightness;\n    \n    \n    return col;\n}\n\nstatic float3 stars[100];\n\nfloat4 Star2(ray r, int i) {\n    float3 sparkPos = stars[10];\n    float3 closestPoint = ClosestPoint(r, sparkPos);\n    \n    float dist = DistSqr(closestPoint, sparkPos)/(0.01);\n    float brightness = 1./dist;\n    float4 col = float4(brightness, brightness, brightness, brightness);\n    \n    \n    return col;\n}\n\nfloat4 Stars(ray r) {\n    float4 col = float4(0., 0., 0., 0.);\n    \n    float s = 0.;\n    for(int si=0; si<NUM_STARS; si++) {\n    \ts++;\n        col += Star(r, Noise101(s));\n    }\n    \n    return col;\n}\n\nfloat Greasy(float3 I) {\n    float3 q = 8.0*I;\n    float f;\n    f  = 0.5000*noise( q ); q = mul(m, q) * 2.01;\n    f += 0.2500*noise( q ); q = mul(m, q) * 2.02;\n    f += 0.1250*noise( q ); q = mul(m, q) * 2.03;\n    f += 0.0625*noise( q ); q = mul(m, q) * 2.01;\n    \n    return f;\n        \n}\n\nfloat4 CalcStarPos(int i) {\n\t// returns the position in xyz and the fade value in w\n    \n    float n = Noise101(float(i));\n    \n    float4 noise = Noise4(float4(n, n+1., n+2., n+3.));\n    \n\tfloat t = frac(gTime*0.1+n)*2.;\n    \n    float fade = smoothstep(2., 0.5, t);\t\t// fade out;\n    \n    float size = STARSIZE+n*0.03;\t\t\t\t\t// random variation in size\n    size *= fade;\n    \n    float b = BounceNorm(t, 0.4+n*0.1)*7.;\n    b+=size;\n    \n    float3 sparkPos = float3(noise.x*10., b, noise.y*10.);\n    \n    return float4(sparkPos.x, sparkPos.y, sparkPos.z, fade);\n}\n\nfloat4 Ground(ray r) {\n\t\n    float4 ground = float4(0., 0., 0., 0.);\n    \n    if(r.d.y>0.) return ground;\n    \n    float3 I = IntersectPlane(r);\t\t// eye-ray ground intersection point\n    \n    float3 R = reflect(r.d, up);\n    ray ref; ref.o = I; ref.d = R;\n    \n    for(int si=0; si<NUM_STARS; si++) {\n    \tfloat4 star = CalcStarPos(si);\n        \n        float3 L = star.xyz-I;\n        float dist = length(L);\n        L /= dist;\n        \n        float lambert = saturate(dot(L, up));\n        float light = lambert/pow(dist,1.);\n       \n        \n        float4 col = lerp(COOLCOLOR, MIDCOLOR, star.w); // vary color with size\n        float4 diffuseLight =  float4(light, light, light, light)*0.1*col;\n        \n        ground += diffuseLight*(sin(gTime)*0.5+0.6);\n        \n        #ifdef FLOOR_REFLECT\n        float spec = pow(saturate(dot(R, L)), 400.);\n        float fresnel = 1.-saturate(dot(L, up));\n        fresnel = pow(fresnel, 10.);\n        \n        float4 specLight = col*spec/(dist);\n        specLight *= star.w;\n        ground += specLight*0.5*fresnel;\n        #endif\n        \n    }\n    \n    \n    return ground;\n}\n\nshader_body {\nfloat2 uvn = ((uv * texsize.xy).xy / texsize.xy) - 0.5;\n   \tuvn.y *= texsize.y/texsize.x;\n    \n\tgTime = time * 0.2;\n    ret = float4(uvn.x, uvn.y, 0.5 + 0.5 * sin(time), 1.0);\n    \n   \n    gTime *= 2.;\n    \n\tfloat t = gTime*pi*0.1;\n    COOLCOLOR = float4(sin(t), cos(t*0.23), cos(t*0.3453), 1.)*0.5+0.5;\n    HOTCOLOR = float4(sin(t*2.), cos(t*2.*0.33), cos(t*0.3453), 1.)*0.5+0.5;\n   \t\n    float4 white = float4(1., 1., 1., 1.);\n    float whiteFade = sin(gTime*2.)*0.5+0.5;\n    HOTCOLOR = lerp(HOTCOLOR, white, whiteFade);\n    \n    MIDCOLOR = (HOTCOLOR+COOLCOLOR)*0.5;\n    \n    float s = sin(t);\n    float c = cos(t);\n    float3x3 rot = float3x3(\t  c,  0., s,\n                   \t\t  0., 1., 0.,\n                   \t\t  s,  0., -c);\n    \n    float camHeight = lerp(3.5, 0.1, PeriodicPulse(gTime*0.1, 2.));\n    float3 pos = mul(float3(0., camHeight, -10.), rot) * (1. + sin(gTime) * 0.3);\n   \t\n    CameraSetup(uvn, pos, float3(0., 0., 0.), 0.5);\n    \n    ret = Ground(cam.ray);\n    ret += Stars(cam.ray);\n}\n"
}
