{
  "version": 1,
  "shadertoy": true,
  "name": "sb_tunnel_curve",
  "notes": {
    "image": "Snaking space tunnel: large time/depth path (vanishing point wanders ~1/3 of screen). Music dens/scroll/sparks near-ambient (~0.5% of sb_tunnel). Free to redistribute.",
    "bufferA": "Nebula follows snaking vanishing point; very low audio energy."
  },
  "bufferA": "// CURVE — large space-snake (time/depth); music almost ambient\n// Buffer A: nebula glued to snaking vanishing point\n\nfloat hash21(float2 p)\n{\n    float3 p3 = frac(float3(p.xyx) * float3(0.1031, 0.1030, 0.0973));\n    p3 += dot(p3, p3.yzx + 33.33);\n    return frac((p3.x + p3.y) * p3.z);\n}\n\nfloat vnoise(float2 p)\n{\n    float2 i = floor(p);\n    float2 f = frac(p);\n    f = f * f * (3.0 - 2.0 * f);\n    float a = hash21(i);\n    float b = hash21(i + float2(1, 0));\n    float c = hash21(i + float2(0, 1));\n    float d = hash21(i + float2(1, 1));\n    return lerp(lerp(a, b, f.x), lerp(c, d, f.x), f.y);\n}\n\nfloat fbm(float2 p)\n{\n    float v = 0.0, a = 0.5;\n    [unroll] for (int k = 0; k < 4; k++) {\n        v += a * vnoise(p);\n        p = p * 2.02 + float2(3.1, 7.4);\n        a *= 0.5;\n    }\n    return v;\n}\n\n// Path of tunnel centerline in screen-aspect units (half-height ~= 0.5).\n// Depth is along-tunnel distance; time advances travel.\nfloat2 tunnelPath(float depth, float t, float ba, float mi, float vv)\n{\n    // BIG geometric snake — always visible without audio\n    float2 path;\n    path.x = 0.32 * sin(depth * 0.55 + t * 0.28)\n           + 0.18 * sin(depth * 0.22 + t * 0.11)\n           + 0.10 * sin(depth * 1.15 + t * 0.41);\n    path.y = 0.26 * cos(depth * 0.48 + t * 0.23)\n           + 0.14 * cos(depth * 0.19 - t * 0.09)\n           + 0.08 * cos(depth * 0.95 + t * 0.33);\n    // Tiny music nudge (~0.5% of a full reactive path)\n    path.x += 0.004 * sin(t * 0.5 + ba * 3.0) * (1.0 + ba + vv);\n    path.y += 0.0035 * cos(t * 0.4 + mi * 2.5) * (1.0 + mi + vv);\n    return path;\n}\n\nfloat2 applySnake(float2 p0, float ba, float mi, float tr, float vv)\n{\n    // Two-pass depth estimate so path depends on curved space a bit\n    float r0 = max(length(p0), 1e-4);\n    float d0 = 0.16 / r0;\n    float2 path0 = tunnelPath(d0 + time * 0.12, time, ba, mi, vv);\n    // Vanishing-point offset grows toward center (far) — classic curved tunnel look\n    float far = saturate(1.15 - r0 * 1.6); // ~1 at center, ~0 at edges\n    float2 p1 = p0 - path0 * (0.55 + 0.85 * far);\n\n    float r1 = max(length(p1), 1e-4);\n    float d1 = 0.16 / r1;\n    float2 path1 = tunnelPath(d1 + time * 0.12, time, ba, mi, vv);\n    float far1 = saturate(1.15 - r1 * 1.6);\n    float2 p = p0 - path1 * (0.65 + 0.95 * far1);\n\n    // Slow roll of the whole corridor\n    float twist = d1 * 0.12 + time * 0.055;\n    float cs = cos(twist), sn = sin(twist);\n    p = float2(p.x * cs - p.y * sn, p.x * sn + p.y * cs);\n    return p;\n}\n\nshader_body\n{\n    float2 res = texsize.xy;\n    float2 frag = uv * res;\n    float2 p0 = (frag - 0.5 * res) / max(res.y, 1.0);\n\n    float ba = saturate(bass);\n    float mi = saturate(mid);\n    float tr = saturate(treb);\n    float vv = saturate(vol);\n\n    float2 p = applySnake(p0, ba, mi, tr, vv);\n    float rr = length(p) + 1e-4;\n\n    float3 prev = tex2D(sampler_feedback, uv).rgb;\n    float prevL = max(dot(prev, float3(0.299, 0.587, 0.114)), 0.0);\n    prev *= 0.48 * smoothstep(0.01, 0.06, prevL);\n\n    float2 np = p * 2.4;\n    float ca = time * 0.045;\n    float2 rp = float2(np.x * cos(ca) - np.y * sin(ca), np.x * sin(ca) + np.y * cos(ca));\n    float cn1 = fbm(rp * 1.35 + time * 0.03);\n    float cn2 = fbm(rp * 2.7 - time * 0.024 + 4.0);\n    float cn3 = fbm(rp * 4.8 + time * 0.018 + 9.0);\n    float neb = saturate(cn1 * 0.45 + cn2 * 0.3 + cn3 * 0.26 - 0.16);\n    float core = exp(-rr * rr * 8.0);\n    float outerGate = 1.0 - smoothstep(0.22, 0.55, rr);\n    // ~0.5% audio on nebula energy\n    neb *= core * outerGate * (0.55 + 0.35 * cn2) * (0.72 + ba * 0.002 + vv * 0.0015);\n\n    float tHue = time * 0.032;\n    float3 nA = 0.4 + 0.4 * cos(6.2831853 * (tHue + float3(0.00, 0.33, 0.67)));\n    float3 nB = 0.4 + 0.4 * cos(6.2831853 * (tHue * 0.7 + 0.2 + float3(0.1, 0.45, 0.75)));\n    float3 nC = 0.42 + 0.38 * cos(6.2831853 * (tHue * 1.25 + 0.45 + float3(0.05, 0.4, 0.8)));\n    float3 nebCol = lerp(nA, nB, saturate(cn1));\n    nebCol = lerp(nebCol, nC, saturate(cn2 * 0.4));\n    nebCol = lerp(nebCol, float3(0.75, 0.5, 0.6), 0.08);\n    nebCol *= neb * 0.95;\n\n    float3 field = prev + nebCol;\n    if (frame < 2.0) field = nebCol;\n\n    ret = float4(saturate(field), 1.0);\n}\n",
  "image": "// CURVE — snaking space tunnel (large geometric path)\n// Music: near-ambient dens/scroll (~0.5% of sb_tunnel). Snake is time/depth.\n\nfloat hash21(float2 p)\n{\n    float3 p3 = frac(float3(p.xyx) * float3(0.1031, 0.1030, 0.0973));\n    p3 += dot(p3, p3.yzx + 33.33);\n    return frac((p3.x + p3.y) * p3.z);\n}\n\nfloat2 hash22(float2 p)\n{\n    float n = hash21(p);\n    return float2(n, hash21(p + n + 13.1));\n}\n\nfloat vnoise(float2 p)\n{\n    float2 i = floor(p);\n    float2 f = frac(p);\n    f = f * f * (3.0 - 2.0 * f);\n    float a = hash21(i);\n    float b = hash21(i + float2(1, 0));\n    float c = hash21(i + float2(0, 1));\n    float d = hash21(i + float2(1, 1));\n    return lerp(lerp(a, b, f.x), lerp(c, d, f.x), f.y);\n}\n\nfloat fbm(float2 p)\n{\n    float v = 0.0, a = 0.5;\n    [unroll] for (int k = 0; k < 3; k++) {\n        v += a * vnoise(p);\n        p = p * 2.05 + float2(2.7, 5.1);\n        a *= 0.5;\n    }\n    return v;\n}\n\nfloat softDisk(float d, float outer)\n{\n    float inner = outer * 0.18;\n    float t = 1.0 - smoothstep(inner, max(outer, inner + 1e-5), d);\n    return t * t;\n}\n\nfloat3 polarLayer(float u, float v, float densU, float densV, float szMul, float seed, float densGate)\n{\n    float2 gv = float2(frac(u) * densU, v * densV);\n    float2 cell = floor(gv);\n    float2 f = frac(gv);\n    float3 sum = 0;\n\n    [unroll] for (int k = 0; k < 2; k++) {\n        float kf = k * 1.0;\n        float2 rnd = hash22(cell + float2(seed * 17.0 + kf * 9.1, seed * 5.3 + kf * 4.7));\n        float gate = step(rnd.x, densGate);\n        float2 sp = hash22(cell + float2(3.1 + kf, 8.4 + seed));\n        float2 dlt = f - sp;\n        dlt.y *= 0.65;\n        float outer = max((0.07 + rnd.y * 0.05) * szMul, 0.018);\n        float spark = softDisk(length(dlt), outer) * gate;\n        float hue = frac(rnd.x * 0.8 + rnd.y * 0.3 + seed * 0.11);\n        float3 col = 0.45 + 0.4 * cos(6.2831853 * (hue + float3(0.0, 0.33, 0.67)));\n        sum += col * spark * (0.75 + rnd.y * 0.55);\n    }\n    return sum;\n}\n\nfloat2 tunnelPath(float depth, float t, float ba, float mi, float vv)\n{\n    float2 path;\n    path.x = 0.32 * sin(depth * 0.55 + t * 0.28)\n           + 0.18 * sin(depth * 0.22 + t * 0.11)\n           + 0.10 * sin(depth * 1.15 + t * 0.41);\n    path.y = 0.26 * cos(depth * 0.48 + t * 0.23)\n           + 0.14 * cos(depth * 0.19 - t * 0.09)\n           + 0.08 * cos(depth * 0.95 + t * 0.33);\n    path.x += 0.004 * sin(t * 0.5 + ba * 3.0) * (1.0 + ba + vv);\n    path.y += 0.0035 * cos(t * 0.4 + mi * 2.5) * (1.0 + mi + vv);\n    return path;\n}\n\nfloat2 applySnake(float2 p0, float ba, float mi, float tr, float vv)\n{\n    float r0 = max(length(p0), 1e-4);\n    float d0 = 0.16 / r0;\n    float2 path0 = tunnelPath(d0 + time * 0.12, time, ba, mi, vv);\n    float far = saturate(1.15 - r0 * 1.6);\n    float2 p1 = p0 - path0 * (0.55 + 0.85 * far);\n\n    float r1 = max(length(p1), 1e-4);\n    float d1 = 0.16 / r1;\n    float2 path1 = tunnelPath(d1 + time * 0.12, time, ba, mi, vv);\n    float far1 = saturate(1.15 - r1 * 1.6);\n    float2 p = p0 - path1 * (0.65 + 0.95 * far1);\n\n    float twist = d1 * 0.12 + time * 0.055;\n    float cs = cos(twist), sn = sin(twist);\n    p = float2(p.x * cs - p.y * sn, p.x * sn + p.y * cs);\n    return p;\n}\n\nshader_body\n{\n    float2 res = texsize.xy;\n    float2 frag = uv * res;\n    float2 p0 = (frag - 0.5 * res) / max(res.y, 1.0);\n\n    float ba = saturate(bass);\n    float mi = saturate(mid);\n    float tr = saturate(treb);\n    float vv = saturate(vol);\n\n    float2 p = applySnake(p0, ba, mi, tr, vv);\n\n    float rd = max(length(p), 1e-4);\n    float an = atan2(p.y, p.x);\n\n    float u = an * (0.5 / 3.14159265) + 0.5;\n    float dep = 0.16 / rd;\n\n    // Near-ambient travel ( ~0.5% of full tunnel audio boosts )\n    float scroll = 0.09 + ba * 0.0005 + vv * 0.0003 + mi * 0.0001;\n    float spinU = 0.010 + mi * 0.0001 + ba * 4e-05;\n    // Shear star lanes along the path so walls feel bent, not just recentered\n    float2 pathVis = tunnelPath(dep + time * 0.12, time, ba, mi, vv);\n    float uShear = pathVis.x * 0.85 + pathVis.y * 0.45;\n    float u1 = u + time * spinU + uShear;\n    float v1 = dep + time * scroll;\n    float u2 = u1 + 0.18;\n    float v2 = dep * 1.22 + time * (scroll * 1.28);\n\n    float densGate = saturate(0.34 + ba * 0.0009 + vv * 0.0005);\n    float sizeBoost = 0.95 + tr * 0.0014 + ba * 0.0006;\n    float bri = 0.80 + ba * 0.0018 + vv * 0.001 + tr * 0.0005;\n\n    float3 stars = 0;\n    stars += polarLayer(u1, v1, 19.0, 10.5, 1.25 * sizeBoost, 1.0, densGate);\n    stars += polarLayer(u1 + 0.33, v1 * 1.1 + 3.0, 31.0, 16.5, 0.8 * sizeBoost, 2.0, densGate * 0.92) * 0.75;\n    stars += polarLayer(u2, v2, 44.0, 23.0, 0.55 * sizeBoost, 3.0, densGate * 0.88) * 0.6;\n    stars += polarLayer(u1 + 0.5, v1 * 0.65 + 7.0, 8.5, 6.2, 1.7 * sizeBoost, 4.0, densGate * 0.62) * 1.05;\n    stars *= bri;\n\n    float starL = max(dot(stars, float3(0.299, 0.587, 0.114)), 0.0);\n    float3 cool = float3(0.75, 0.85, 1.15);\n    float3 warm = float3(1.15, 0.85, 0.7);\n    float3 starTint = lerp(cool, warm, saturate(0.26 + 0.09 * sin(time * 0.05)));\n    float tintAmt = saturate(starL * 2.5);\n    stars *= lerp(float3(1.0, 1.0, 1.0), starTint, tintAmt * 0.35);\n\n    float radial = smoothstep(0.02, 0.18, rd) * (1.0 - smoothstep(0.5, 1.2, rd));\n    float3 tunnel = stars * (0.55 + 0.45 * radial);\n    tunnel *= 0.55 + 0.45 * smoothstep(0.0, 0.14, rd);\n\n    float3 fog = tex2D(sampler_feedback, uv).rgb;\n    float fogL = max(dot(fog, float3(0.299, 0.587, 0.114)), 0.0);\n    float core = exp(-rd * rd * 6.2);\n    float centerGate = 1.0 - smoothstep(0.18, 0.48, rd);\n\n    float2 np = p * 2.5;\n    float ca = time * 0.045;\n    float2 rp = float2(np.x * cos(ca) - np.y * sin(ca), np.x * sin(ca) + np.y * cos(ca));\n    float n1 = fbm(rp * 1.25 + time * 0.035);\n    float n2 = fbm(rp * 2.5 - time * 0.028 + 5.0);\n    float cloud = saturate(n1 * 0.42 + n2 * 0.36 - 0.14);\n    float halo = exp(-rd * rd * 2.0) * 0.32;\n    float nebMask = (cloud * core + halo * (0.25 + 0.2 * n2)) * centerGate;\n    nebMask *= 0.72 + ba * 0.002 + vv * 0.001;\n\n    float tHue = time * 0.035;\n    float3 cA = 0.4 + 0.4 * cos(6.2831853 * (tHue + float3(0.0, 0.33, 0.67)));\n    float3 cB = 0.4 + 0.4 * cos(6.2831853 * (tHue * 0.65 + 0.25 + float3(0.12, 0.45, 0.78)));\n    float3 nebCol = lerp(cA, cB, saturate(n1));\n    nebCol = lerp(nebCol, float3(0.7, 0.45, 0.55), 0.1);\n    nebCol *= nebMask * 0.85;\n    nebCol += fog * core * centerGate * smoothstep(0.02, 0.1, fogL) * 0.45;\n\n    float3 col = tunnel + nebCol;\n\n    // Nearly mute hit sparks\n    float hitEnergy = saturate(ba * 0.0035 + vv * 0.0015);\n    float hitGate = step(0.35, hitEnergy);\n    const int N = 10;\n    [loop] for (int i = 0; i < N; i++) {\n        float id = i * 1.0;\n        float2 rnd = hash22(float2(id * 5.1, id * 9.7) + rand_preset.xy * 4.0);\n        float life = frac(time * (0.28 + rnd.x * 0.18) + rnd.y);\n        float gate = step(rnd.x, 0.18 + hitEnergy * 0.3) * hitGate;\n        float rNow = 0.05 + life * 0.30 * (0.7 + rnd.y * 0.45);\n        float dir = (rnd.x > 0.5) ? 1.0 : -1.0;\n        float aNow = rnd.y * 6.2831853 + life * (-0.4) * dir;\n        float2 pos = float2(cos(aNow), sin(aNow)) * rNow;\n        float d = length(p - pos);\n        float outer = max(0.004 + rnd.x * 0.003, 0.002);\n        float spark = softDisk(d, outer);\n        spark *= gate * smoothstep(0.0, 0.06, life) * (1.0 - smoothstep(0.7, 1.0, life));\n        spark *= hitEnergy * 0.7;\n        float hue = frac(rnd.x * 0.6);\n        float3 pcol = 0.48 + 0.4 * cos(6.2831853 * (hue + float3(0.0, 0.33, 0.67)));\n        col += pcol * spark * 0.85;\n    }\n\n    float lum = max(dot(col, float3(0.299, 0.587, 0.114)), 0.0);\n    col = col * rcp(1.0 + lum * 0.22);\n    col = saturate(col);\n\n    ret = float4(col, 1.0);\n}\n",
  "channels": {
    "bufferA": {
      "iChannel0": "self"
    },
    "image": {
      "iChannel0": "bufferA"
    }
  }
}
