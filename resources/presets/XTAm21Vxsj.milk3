{
  "version": 1,
  "shadertoy": true,
  "name": "XTAm21Vxsj",
  "channels": {
    "image": {
      "iChannel0": "self"
    }
  },
  "image": "// The Universe Within - by Martijn Steinrucken aka BigWings 2018\n// License CC BY-NC-SA 3.0. Converted from SHADERed GLSL for MDropDX12.\n\n#define S(a, b, t) smoothstep(a, b, t)\n#define NUM_LAYERS 4.0\n\nfloat N21(float2 p)\n{\n  float3 a = frac(float3(p.xyx) * float3(213.897, 653.453, 253.098));\n  a += dot(a, a.yzx + 79.76);\n  return frac((a.x + a.y) * a.z);\n}\n\nfloat2 GetPos(float2 id, float2 offs, float t)\n{\n  float n = N21(id + offs);\n  float n1 = frac(n * 10.0);\n  float n2 = frac(n * 100.0);\n  float a = t + n;\n  return offs + float2(sin(a * n1), cos(a * n2)) * 0.4;\n}\n\nfloat df_line(float2 a, float2 b, float2 p)\n{\n  float2 pa = p - a, ba = b - a;\n  float h = saturate(dot(pa, ba) / max(dot(ba, ba), 1e-6));\n  return length(pa - ba * h);\n}\n\n// line is reserved in HLSL - use line2\n// never name a formal param uv (milk3 defines uv as _uv.xy)\nfloat line2(float2 a, float2 b, float2 puv)\n{\n  float r1 = 0.04;\n  float r2 = 0.01;\n  float d = df_line(a, b, puv);\n  float d2 = length(a - b);\n  float fade = S(1.5, 0.5, d2);\n  fade += S(0.05, 0.02, abs(d2 - 0.75));\n  return S(r1, r2, d) * fade;\n}\n\nvoid AccPoint(float2 p4, float2 q, float2 st, float t, inout float m, inout float sparkle)\n{\n  m += line2(p4, q, st);\n  float d = length(st - q);\n  float s = 0.005 / max(d * d, 1e-6);\n  s *= S(1.0, 0.7, d);\n  float pulse = sin((frac(q.x) + frac(q.y) + t) * 5.0) * 0.4 + 0.6;\n  pulse = pow(pulse, 20.0);\n  s *= pulse;\n  sparkle += s;\n}\n\nfloat NetLayer(float2 st, float n, float t)\n{\n  float2 id = floor(st) + n;\n  st = frac(st) - 0.5;\n\n  float2 p0 = GetPos(id, float2(-1, -1), t);\n  float2 p1 = GetPos(id, float2( 0, -1), t);\n  float2 p2 = GetPos(id, float2( 1, -1), t);\n  float2 p3 = GetPos(id, float2(-1,  0), t);\n  float2 p4 = GetPos(id, float2( 0,  0), t);\n  float2 p5 = GetPos(id, float2( 1,  0), t);\n  float2 p6 = GetPos(id, float2(-1,  1), t);\n  float2 p7 = GetPos(id, float2( 0,  1), t);\n  float2 p8 = GetPos(id, float2( 1,  1), t);\n\n  float m = 0.0;\n  float sparkle = 0.0;\n\n  AccPoint(p4, p0, st, t, m, sparkle);\n  AccPoint(p4, p1, st, t, m, sparkle);\n  AccPoint(p4, p2, st, t, m, sparkle);\n  AccPoint(p4, p3, st, t, m, sparkle);\n  AccPoint(p4, p4, st, t, m, sparkle);\n  AccPoint(p4, p5, st, t, m, sparkle);\n  AccPoint(p4, p6, st, t, m, sparkle);\n  AccPoint(p4, p7, st, t, m, sparkle);\n  AccPoint(p4, p8, st, t, m, sparkle);\n\n  m += line2(p1, p3, st);\n  m += line2(p1, p5, st);\n  m += line2(p7, p5, st);\n  m += line2(p7, p3, st);\n\n  float sPhase = (sin(t + n) + sin(t * 0.1)) * 0.25 + 0.5;\n  sPhase += pow(sin(t * 0.1) * 0.5 + 0.5, 50.0) * 5.0;\n  m += sparkle * sPhase;\n  return m;\n}\n\nshader_body {\n  float2 uvn = (uv - 0.5) * float2(texsize.x / max(texsize.y, 1.0), 1.0);\n  float2 M = mouse.xy / max(texsize.xy, float2(1.0, 1.0)) - 0.5;\n\n  float t = time * 0.1;\n  float s = sin(t);\n  float c = cos(t);\n  float2x2 rot = float2x2(c, -s, s, c);\n  float2 st = mul(uvn, rot);\n  M = mul(M, rot * 2.0);\n\n  float m = 0.0;\n  [loop] for (int li = 0; li < 4; li++)\n  {\n    float i = (float)li / NUM_LAYERS;\n    float z = frac(t + i);\n    float size = lerp(15.0, 1.0, z);\n    float fade = S(0.0, 0.6, z) * S(1.0, 0.8, z);\n    m += fade * NetLayer(st * size - M * z, i, time);\n  }\n\n  float fft = 0.0;\n  float glow = -uvn.y * fft * 2.0;\n  float3 baseCol = float3(s, cos(t * 0.4), -sin(t * 0.24)) * 0.4 + 0.6;\n  float3 col = baseCol * m;\n  col += baseCol * glow;\n  col *= 1.0 - dot(uvn, uvn);\n  float tt = fmod(time, 230.0);\n  col *= S(0.0, 20.0, tt) * S(224.0, 200.0, tt);\n\n  ret = float4(col, 1.0);\n}\n"
}
