{
  "version": 1,
  "shadertoy": true,
  "name": "BlueRedShiney",
  "notes": {
    "image": "Same tunnel/glow as original. Framing is aspect-aware: landscape keeps the classic slight look-down (yBias≈0.2); portrait/tall reduces bias toward center, opens FOV a bit, and looks slightly farther ahead so the tunnel sits better on any screen."
  },
  "image": "// BlueRedShiney — aspect-aware framing (one preset, all orientations)\n// Landscape: close to original (u.y -= ~0.2, lookAhead 2, fov 1)\n// Portrait: center tunnel, slightly wider FOV, longer look-ahead\n\n#define T (sin(_c2.x * 0.6) * 16.0 + _c2.x * 1e2)\n#define P(z) (float3(cos((z) * 0.011) * 16.0 + cos((z) * 0.012) * 24.0, cos((z) * 0.01) * 4.0, (z)))\n#define R(a) float2x2(cos(a + float4(0, 33, 11, 0)))\n#define N normalize\n\nfloat boxen(float3 p)\n{\n  p = abs(frac(p / 2e1) * 2e1 - 1e1) - 1.0;\n  return min(p.x, min(p.y, p.z));\n}\n\nfloat4 lights = 0;\nfloat map(float3 p)\n{\n  float3 q = P(p.z);\n  float m, g = q.y - p.y + 6.0;\n\n  m = boxen(p);\n  p.xy -= q.xy;\n\n  float red = 0.0, blue = 0.0;\n  float e = min(\n    red  = length(p.xy - sin(p.z / 12.0 + float2(0.0, 1.3)) * 12.0) - 1.0,\n    blue = length(p.xy - sin(p.z / 16.0 + float2(0.0, 0.7)) * 16.0) - 2.0\n  );\n\n  lights += float4(1e1, 2.0, 1.0, 0.0) / (0.1 + abs(red));\n  lights += float4(1.0, 2.0, 1e1, 0.0) / (0.1 + abs(blue) / 1e1);\n\n  p = abs(p);\n\n  float tex = abs(length(sin(p * cos(p.yzx / 3e1) * 4.0) / (p * 4.0)));\n  float tun = min(32.0 - p.x - p.y, 24.0 - p.y);\n\n  float d = max(min(m, g), tun) - tex;\n  return min(e, d);\n}\n\nshader_body\n{\n  float4 o = 0;\n  float2 u = uv * texsize.xy;\n  #undef uv\n  #undef uv_orig\n  #undef mouse\n  #undef mouse_x\n  #undef mouse_y\n  #undef mouse_pos\n  #undef mouse_clicked\n\n  float i = 0.0, s = 0.0, d = 0.0;\n  float3 r = float3(texsize.x, texsize.y, 1.0);\n\n  // Aspect-correct NDC (y ~[-0.5,0.5]); ar = width/height\n  u = (u - r.xy * 0.5) / r.y;\n  float ar = r.x / max(r.y, 1.0);\n  // 0 = strong portrait, 1 = landscape-or-wider (matches original framing)\n  float land = smoothstep(0.55, 1.20, ar);\n\n  // Original used fixed u.y -= 0.2 (look down). Portrait → ~0 (centered).\n  u.y -= land * 0.20;\n\n  // Tall screens: open FOV slightly so the tube isn't cropped top/bottom\n  float fovMul = lerp(1.14, 1.0, land);\n\n  o = float4(0, 0, 0, 0);\n  lights = float4(0, 0, 0, 0);\n\n  // Portrait: look a bit farther ahead so the vanishing point sits higher/centered\n  float lookAhead = lerp(2.6, 2.0, land);\n  float3 p = P(T), ro = p,\n    Z = N(P(T + lookAhead) - p),\n    X = N(float3(Z.z, 0.0, (-Z).x)),\n    D = N(mul(float3x3(-X, cross(X, Z), Z),\n              float3(mul(u * fovMul, R(sin(T * 0.005) * 0.4)), 1.0)));\n\n  for (; i++ < 1e2;)\n  {\n    p = ro + D * d;\n    d += s = map(p) * 0.8;\n    o += lights + 1.0 / max(s, 0.01);\n  }\n\n  const float h = 0.005;\n  const float2 k = float2(1.0, -1.0);\n  float3 n = N(\n    k.xyy * map(p + k.xyy * h) +\n    k.yyx * map(p + k.yyx * h) +\n    k.yxy * map(p + k.yxy * h) +\n    k.xxx * map(p + k.xxx * h)\n  );\n\n  o *= (0.1 + max(dot(n, -D), 0.0));\n\n  float4 ref = 0;\n  lights = float4(0, 0, 0, 0);\n  for (p += n * 0.05, D = reflect(D, n), s = i = 0.0; i++ < 5e1; )\n  {\n    p += D * s;\n    s = map(p) * 0.8;\n    ref += lights + 1.0 / max(s, 0.01);\n  }\n\n  o += o * ref;\n  o = tanh(o / 1e9 * exp(float4(1e1, 2.0, 1.0, 0.0) * d / 5e2));\n  ret = o;\n}\n",
  "channels": {
    "image": {
      "iChannel0": "self"
    }
  }
}
