{
  "version": 1,
  "shadertoy": true,
  "name": "dyinguniverse",
  "channels": {
    "image": {
      "iChannel0": "self"
    }
  },
  "image": "// Dying Universe (sound reactive, AUDIO_REACT=0.01 \u2248 1% of full) \u2014 BigWings 2015\n// Original: Martijn Steinrucken (CC BY-NC-SA 3.0)\n// MDropDX12: bounce/size/brightness gently driven by bass/mid/treb + FFT.\n\nstatic float4 COOLCOLOR = float4(1., .5, 0., 0.);\nstatic float4 HOTCOLOR = float4(0., 0.1, 1., 1.);\nstatic float4 MIDCOLOR = float4(0.5, 0.3, 0., 1.);\nstatic float STARSIZE = 0.03;\n\n// 64 keeps FXC under milk3's ~8s load timeout (100 + FFT was ~14s)\n#define NUM_STARS 64\n#define NUM_BOUNCES 6\n#define FLOOR_REFLECT\n// Audio influence scale: 0.01 = 1% of full reactive tuning (99% reduced)\n#define AUDIO_REACT 0.01\n\nfloat DistSqr(float3 a, float3 b) { float3 D = a - b; return dot(D, D); }\nfloat dist2(float2 P0, float2 P1) { float2 D = P1 - P0; return dot(D, D); }\n\nstatic const float3 up = float3(0., 1., 0.);\nstatic const float pi = 3.141592653589793238;\nstatic const float twopi = 6.283185307179586;\nstatic float gTime;\n\nstruct ray {\n    float3 o;\n    float3 d;\n};\nstatic ray e;\n\nstruct camera {\n    float3 p;\n    float3 forward;\n    float3 left;\n    float3 up;\n    float3 center;\n    float3 hit;\n    ray ray;\n    float3 lookAt;\n    float zoom;\n};\nstatic camera cam;\n\nvoid CameraSetup(float2 puv, float3 position, float3 lookAt, float zoom)\n{\n    cam.p = position;\n    cam.lookAt = lookAt;\n    cam.forward = normalize(cam.lookAt - cam.p);\n    cam.left = cross(up, cam.forward);\n    cam.up = cross(cam.forward, cam.left);\n    cam.zoom = zoom;\n    cam.center = cam.p + cam.forward * cam.zoom;\n    cam.hit = cam.center + cam.left * puv.x + cam.up * puv.y;\n    cam.ray.o = cam.p;\n    cam.ray.d = normalize(cam.hit - cam.p);\n}\n\nfloat4 Noise401(float4 x) { return frac(sin(x) * 5346.1764); }\nfloat4 Noise4(float4 x) { return frac(sin(x) * 5346.1764) * 2. - 1.; }\nfloat Noise101(float x) { return frac(sin(x) * 5346.1764); }\n\nfloat hash(float n) { return frac(sin(n) * 753.5453123); }\nfloat noise(float3 x)\n{\n    float3 p = floor(x);\n    float3 f = frac(x);\n    f = f * f * (3.0 - 2.0 * f);\n    float n = p.x + p.y * 157.0 + 113.0 * p.z;\n    return lerp(lerp(lerp(hash(n + 0.0), hash(n + 1.0), f.x),\n                     lerp(hash(n + 157.0), hash(n + 158.0), f.x), f.y),\n                lerp(lerp(hash(n + 113.0), hash(n + 114.0), f.x),\n                     lerp(hash(n + 270.0), hash(n + 271.0), f.x), f.y), f.z);\n}\n\nstatic const float3x3 m = float3x3(\n    0.00, 0.80, 0.60,\n   -0.80, 0.36, -0.48,\n   -0.60, -0.48, 0.64);\n\nfloat PeriodicPulse(float x, float p)\n{\n    return pow((cos(x + sin(x)) + 1.) / 2., p);\n}\n\nfloat3 ClosestPoint(ray r, float3 p)\n{\n    return r.o + max(0., dot(p - r.o, r.d)) * r.d;\n}\n\nfloat BounceNorm(float t, float decay)\n{\n    float height = 1.0;\n    float heights[7];\n    float halfDurations[7];\n    heights[0] = 1.0;\n    halfDurations[0] = 1.0;\n    float halfDuration = 0.5;\n    [loop] for (int bi = 1; bi < 7; bi++) {\n        height *= decay;\n        heights[bi] = height;\n        halfDurations[bi] = sqrt(height);\n        halfDuration += halfDurations[bi];\n    }\n    t *= halfDuration * 2.0;\n    float y = 1.0 - t * t;\n    [loop] for (int bj = 1; bj < 7; bj++) {\n        t -= halfDurations[bj - 1] + halfDurations[bj];\n        y = max(y, heights[bj] - t * t);\n    }\n    return saturate(y);\n}\n\nfloat3 IntersectPlane(ray r, float4 plane)\n{\n    float3 n = plane.xyz;\n    float3 p0 = plane.xyz * plane.w;\n    float t = dot(p0 - r.o, n) / max(dot(r.d, n), 1e-5);\n    return r.o + max(0., t) * r.d;\n}\n\nfloat3 IntersectPlane(ray r)\n{\n    return IntersectPlane(r, float4(0., 1., 0., 0.));\n}\n\n// --- Audio: per-particle energy (bands + one FFT bin per seed) ---\n// seed is ~[0,1] noise. Returns float4(drive, spark, rateFull, brightFull)\n// at AUDIO_REACT=1.0; callers lerp toward quiet baselines with AUDIO_REACT.\nfloat4 ParticleAudio(float seed)\n{\n    float band = get_fft(frac(seed * 5.17) * 0.88);\n    float bassW = lerp(1.15, 0.55, seed);\n    float trebW = lerp(0.45, 1.20, seed);\n\n    float drive = saturate(\n        bass_smooth * 0.60 * bassW +\n        mid_smooth * 0.32 +\n        band * 0.85 +\n        bass_att * 0.60 * bassW);\n\n    float spark = saturate(\n        treb_smooth * 0.65 * trebW +\n        band * 0.45 +\n        treb_att * 0.50 * trebW +\n        mid_att * 0.22);\n\n    // Full-reactive rate / brightness (blended with baselines below)\n    float rateFull = 0.075 + bass_smooth * 0.07 + mid_smooth * 0.04 + vol_smooth * 0.03;\n    float brightFull = 0.55 + drive * 1.9 + spark * 1.35 + vol_smooth * 0.9 + bass_att * 0.8;\n\n    return float4(drive, spark, rateFull, brightFull);\n}\n\n// Shared particle kinematics (stars + floor reflections stay in sync)\nvoid ParticleState(float seed, out float3 sparkPos, out float fade, out float size, out float brightMul)\n{\n    float4 n4 = Noise4(float4(seed, seed + 1., seed + 2., seed + 3.));\n    float4 aud = ParticleAudio(seed);\n    float drive = aud.x;\n    float spark = aud.y;\n\n    // Free baseline motion (per-seed rate/height) \u2014 audio only nudges via AUDIO_REACT\n    // Original used rate=0.1 and height=7 for all seeds; vary them so arcs feel alive.\n    float rateBase = 0.095 + seed * 0.055 + n4.z * 0.02;   // ~0.07..0.17\n    float rate = lerp(rateBase, aud.z, AUDIO_REACT);\n    brightMul = lerp(1.0, aud.w, AUDIO_REACT);\n\n    float t = frac(gTime * rate + seed) * 2.0;\n    fade = smoothstep(2.0, 0.5, t);\n\n    size = (STARSIZE + seed * 0.03) * fade;\n    size *= 1.0 + (spark * 2.0 + drive * 0.65) * AUDIO_REACT;\n\n    // Bounce decay: lower decay = more residual hops (original 0.4+seed*0.1)\n    float decay = 0.38 + seed * 0.12;\n    // Height: original ~7; freer baseline 6.5..11 with seed/noise, audio scales on top\n    float heightBase = 6.8 + seed * 3.2 + abs(n4.w) * 1.4;\n    float bounceFull = 3.8 + drive * 10.5 + spark * 2.5 + bass_att * 3.5;\n    float bounceScale = lerp(heightBase, max(heightBase, bounceFull), AUDIO_REACT);\n\n    float b = BounceNorm(t, decay) * bounceScale;\n    b += size;\n\n    // Slight vertical phase offset so not all apexes lock in sync\n    b += 0.15 * sin(seed * 40.0 + gTime * 1.7);\n\n    float spread = 10.0 * (1.0 + seed * 0.08\n        + (bass_smooth * 0.35 + mid_smooth * 0.12) * AUDIO_REACT);\n    sparkPos = float3(n4.x * spread, b, n4.y * spread);\n}\n\nfloat4 Star(ray r, float seed)\n{\n    float3 sparkPos;\n    float fade, size, brightMul;\n    ParticleState(seed, sparkPos, fade, size, brightMul);\n\n    float4 col = lerp(COOLCOLOR, HOTCOLOR, fade);\n    col = lerp(col, float4(1., 1., 1., 1.),\n               saturate(treb_smooth * 0.35 + treb_att * 0.25) * AUDIO_REACT);\n\n    float3 closestPoint = ClosestPoint(r, sparkPos);\n    float dist = DistSqr(closestPoint, sparkPos) / max(size * size, 1e-8);\n    float brightness = 1.0 / max(dist, 1e-4);\n    col *= brightness * brightMul;\n\n    return col;\n}\n\nfloat4 Stars(ray r)\n{\n    float4 col = float4(0., 0., 0., 0.);\n    float s = 0.;\n    for (int si = 0; si < NUM_STARS; si++) {\n        s++;\n        col += Star(r, Noise101(s));\n    }\n    col *= lerp(1.0, 0.85 + vol_smooth * 0.55, AUDIO_REACT);\n    return col;\n}\n\nfloat4 CalcStarPos(int i)\n{\n    float n = Noise101(float(i));\n    float3 sparkPos;\n    float fade, size, brightMul;\n    ParticleState(n, sparkPos, fade, size, brightMul);\n    float w = fade * lerp(1.0, saturate(0.4 + brightMul * 0.35), AUDIO_REACT);\n    return float4(sparkPos.x, sparkPos.y, sparkPos.z, w);\n}\n\nfloat4 Ground(ray r)\n{\n    float4 ground = float4(0., 0., 0., 0.);\n    if (r.d.y > 0.) return ground;\n\n    float3 I = IntersectPlane(r);\n    float3 R = reflect(r.d, up);\n\n    // Original: sin(gTime)*0.5+0.6 ; full reactive added bass/mid\n    float floorPulse = lerp(sin(gTime) * 0.5 + 0.6,\n                            0.55 + bass_smooth * 0.55 + mid_smooth * 0.25 + sin(gTime) * 0.15,\n                            AUDIO_REACT);\n\n    for (int si = 0; si < NUM_STARS; si++) {\n        float4 star = CalcStarPos(si);\n\n        float3 L = star.xyz - I;\n        float dist = length(L);\n        L /= max(dist, 1e-5);\n\n        float lambert = saturate(dot(L, up));\n        float light = lambert / max(pow(dist, 1.), 1e-4);\n\n        float4 col = lerp(COOLCOLOR, MIDCOLOR, star.w);\n        float4 diffuseLight = float4(light, light, light, light) * 0.1 * col;\n\n        ground += diffuseLight * floorPulse;\n\n        #ifdef FLOOR_REFLECT\n        float spec = pow(saturate(dot(R, L)), 400.);\n        float fresnel = 1. - saturate(dot(L, up));\n        fresnel = pow(fresnel, 10.);\n        float4 specLight = col * spec / max(dist, 1e-4);\n        specLight *= star.w;\n        float specAudio = lerp(1.0, 0.7 + mid_smooth * 0.8 + treb_att * 0.6, AUDIO_REACT);\n        ground += specLight * 0.5 * fresnel * specAudio;\n        #endif\n    }\n\n    return ground;\n}\n\nshader_body\n{\n    float2 uvn = ((uv * texsize.xy).xy / texsize.xy) - 0.5;\n    uvn.y *= texsize.y / texsize.x;\n\n    // Clock: original 0.2; full reactive rushed with vol/mid\n    float clockMul = lerp(0.20, 0.18 + vol_smooth * 0.06 + mid_smooth * 0.02, AUDIO_REACT);\n    gTime = time * clockMul;\n    gTime *= 2.0;\n\n    float t = gTime * pi * 0.1;\n    COOLCOLOR = float4(sin(t), cos(t * 0.23), cos(t * 0.3453), 1.) * 0.5 + 0.5;\n    HOTCOLOR = float4(sin(t * 2.), cos(t * 2. * 0.33), cos(t * 0.3453), 1.) * 0.5 + 0.5;\n    float4 white = float4(1., 1., 1., 1.);\n    // Original whiteFade: sin(gTime*2)*0.5+0.5\n    float whiteFadeBase = sin(gTime * 2.) * 0.5 + 0.5;\n    float whiteFadeFull = saturate(0.35 + treb_smooth * 0.45 + sin(gTime * 2.) * 0.2);\n    float whiteFade = lerp(whiteFadeBase, whiteFadeFull, AUDIO_REACT);\n    HOTCOLOR = lerp(HOTCOLOR, white, whiteFade);\n    HOTCOLOR = lerp(HOTCOLOR, float4(1., 0.55, 0.15, 1.),\n                    saturate(bass_att * 0.65) * AUDIO_REACT);\n    MIDCOLOR = (HOTCOLOR + COOLCOLOR) * 0.5;\n\n    float s = sin(t);\n    float c = cos(t);\n    float3x3 rot = float3x3(\n        c, 0., s,\n        0., 1., 0.,\n        s, 0., -c);\n\n    float camHeight = lerp(3.5, 0.1, PeriodicPulse(gTime * 0.1, 2.));\n    camHeight += (bass_att * 0.45 + bass_smooth * 0.15) * AUDIO_REACT;\n    float orbit = 1.0 + sin(gTime) * 0.3 + mid_smooth * 0.08 * AUDIO_REACT;\n    float3 pos = mul(float3(0., camHeight, -10.), rot) * orbit;\n\n    CameraSetup(uvn, pos, float3(0., 0., 0.), 0.5);\n\n    ret = Ground(cam.ray);\n    ret += Stars(cam.ray);\n\n    float vig = 1.0 - saturate(dot(uvn, uvn) * 0.85);\n    ret.rgb *= 0.75 + vig * 0.35;\n    ret.a = 1.0;\n}\n"
}
